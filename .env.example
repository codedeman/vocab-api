# Copy this file to .env and fill in your key:  cp .env.example .env
#
# app/config.py reads .env at the project root. Real environment variables win over
# anything in the file, so `VOCAB_CLASSIFIER=mock uvicorn ...` still overrides it.
#
# VOCAB_CLASSIFIER and VOCAB_ACCESS_KEY have no defaults. Leave either unset and the
# server refuses to start — deliberate, so you never get mock data without asking for it,
# and never publish an open endpoint by forgetting a line.

# --- Who may call this service ------------------------------------------------
# The secret callers must send as the X-API-Key header. NOT the same thing as
# LLM_API_KEY below: this one guards *this* API, that one pays for the LLM.
# 'disabled' serves everyone and logs a WARNING at startup — fine locally, not on a
# public URL, where anyone who finds it would be spending your LLM_API_KEY.
# On Render this is generated for you (render.yaml: generateValue), so don't invent one
# for deployment; generate one here only if you want the gate locally:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
VOCAB_ACCESS_KEY=disabled

# --- Word cache (optional) ---------------------------------------------------
# Postgres connection string, e.g. from neon.com (free, no card):
#   postgresql://user:password@host/dbname?sslmode=require
# Unset = no cache: every lookup calls the LLM. Set but unreachable = the server refuses
# to start. Never used with VOCAB_CLASSIFIER=mock, whose output is fake.
# DATABASE_URL=

# --- The LLM: paste a key, that's it ------------------------------------------
# The provider is recognised from the key, and the endpoint, model and thinking budget
# are filled in for it (app/providers.py). Switching provider = pasting another key.
#   AIza... / AQ....  Gemini -> gemini-3.8-flash, LLM_REASONING_EFFORT=low
#   sk-...    OpenAI      -> gpt-4o-mini
#   sk-or-... OpenRouter  -> openai/gpt-4o-mini
#   gsk_...   Groq        -> llama-3.3-70b-versatile
# Gemini keys: https://aistudio.google.com/apikey. On Google's free tier, text you send
# is used to improve their products — don't send anything confidential.
VOCAB_CLASSIFIER=openai_compatible
LLM_API_KEY=

# --- Overrides (optional) ----------------------------------------------------
# Any of these, when set, wins over what the key implies. Don't leave an old provider's
# LLM_BASE_URL behind when you change key: the server refuses to start on a mismatch.
# Set LLM_REASONING_EFFORT only for a thinking model; other hosts reject the field.
#
# Different model on the same host (e.g. Google retired one; its 502 names the successor)
# LLM_MODEL=gpt-4.1-mini

# DeepSeek — its keys also start with sk-, so it needs the endpoint spelled out
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# Ollama, running locally (any non-empty LLM_API_KEY works; it is ignored)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=ollama

# Anthropic would need its own adapter — its wire format is not OpenAI-compatible —
# so it is not registered in this build.

# --- Offline stand-in --------------------------------------------------------
# Deterministic, no network, no key. Its meanings and explanations are fake and
# prefixed "(mock)". Use it for tests and for working on the API shape, never to
# judge output quality. Set it explicitly:
# VOCAB_CLASSIFIER=mock
